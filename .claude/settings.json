      "Bash(pnpm exec *)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm eslint *)",
      "Bash(pnpm nuxt *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm why *)",
      "Bash(pnpm list *)",
      "Bash(pnpm dedupe *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm peers *)",
      "Bash(npx nuxt *)",
      "Bash(npx nuxi *)",
