{
  "name": "nuxtation",
  "type": "module",
  "version": "4.4.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "description": "Nuxtation project",
  "author": "annrie <annrie@users.noreply.github.com>",
  "license": "MIT",
  "main": "./nuxt.config.ts",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "VITE_APP_ENV=production NODE_OPTIONS='--max-old-space-size=16384' nuxi build",
    "dev": "nuxi dev -o",
    "start": "node .output/server/index.mjs",
    "generate": "VITE_APP_ENV=production NODE_OPTIONS='--max-old-space-size=16384' nuxi generate",
    "preview": "npx serve dist",
    "mdts": "npx mdts",
    "postinstall": "nuxi prepare",
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:contrast": "npx tsx scripts/check-contrast.ts",
    "release:patch": "changelogen --release --patch",
    "release:minor": "changelogen --release --minor",
    "release:major": "changelogen --release --major",
    "oco": "opencommit",
    "lloco": "OCO_AI_PROVIDER='ollama' opencommit",
    "lighthouse": "./scripts/lighthouse-production.sh --accurate"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@iconify/json": "^2.2.503",
    "@imgix/js-core": "^3.8.0",
    "@imgix/vue": "^3.1.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/robots": "^6.1.3",
    "@nuxtjs/seo": "^5.3.3",
    "@rollup/plugin-yaml": "^4.1.2",
    "@shikijs/twoslash": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "buffer": "^6.0.3",
    "docus": "5.12.3",
    "js-yaml": "^5.2.2",
    "kiso.css": "^1.2.4",
    "mdast-util-to-string": "^4.0.0",
    "node-gyp": "^12.4.0",
    "nuxt-content-twoslash": "^0.4.0",
    "open-graph-scraper": "^6.12.0",
    "remark-oembed": "^1.2.2",
    "slugify": "^1.6.9",
    "unist-util-stringify-position": "^4.0.0",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@formkit/nuxt": "^2.1.0",
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/material-symbols": "^1.2.86",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/prime": "^1.2.5",
    "@iconify-json/streamline": "^1.2.5",
    "@iconify-json/twemoji": "^1.2.5",
    "@lhci/cli": "^0.15.1",
    "@mdi/js": "^7.4.47",
    "@nuxt/content": "3.15.0",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/kit": "^4.5.0",
    "@nuxt/scripts": "^1.3.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "10.4.1",
    "@nuxtjs/mdc": "0.22.2",
    "@nuxtjs/sitemap": "8.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.5",
    "@unhead/vue": "^3.2.1",
    "@unocss/eslint-plugin": "^66.7.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "browserslist": "^4.28.6",
    "changelogen": "^0.6.2",
    "cssnano": "^8.0.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "nuxt": "^4.5.0",
    "postcss-media-hover-any-hover": "^0.5.0",
    "postcss-preset-env": "^11.3.2",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "simple-git-hooks": "^2.13.1",
    "socket.io-client": "^4.8.3",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unist-util-visit": "^5.1.0",
    "unplugin-icons": "^23.0.1",
    "vite-imagetools": "^10.0.1",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "vue3-carousel-nuxt": "1.1.6"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "changelog": {
    "types": {
      "feat": {
        "title": "🚀 新機能",
        "semver": "minor"
      },
      "fix": {
        "title": "🐛 バグ修正",
        "semver": "patch"
      },
      "perf": {
        "title": "⚡ パフォーマンスの向上",
        "semver": "patch"
      },
      "refactor": {
        "title": "♻️ リファクタリング",
        "semver": "patch"
      },
      "docs": {
        "title": "📖 ドキュメント"
      },
      "style": {
        "title": "🎨 コードスタイル"
      },
      "test": {
        "title": "✅ テストの追加・修正"
      },
      "ci": {
        "title": "🤖 CI関連"
      },
      "build": {
        "title": "📦 ビルド",
        "semver": "patch"
      },
      "chore": {
        "title": "🧹 ビルドプロセスまたは補助ツールの変更"
      },
      "config": {
        "title": "🔧 設定ファイル"
      },
      "package": {
        "title": "📦 パッケージ"
      }
    },
    "templates": {
      "commitMessage": "chore(release): 🏹v{{newVersion}}",
      "tagMessage": "v{{newVersion}}",
      "tagBody": "v{{newVersion}}"
    }
  }
}
